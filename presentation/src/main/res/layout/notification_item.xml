<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_6sdp"
    android:background="@color/white"
    app:cardCornerRadius="@dimen/_12sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/notification_client_image"
            android:layout_width="@dimen/_48sdp"
            android:layout_height="@dimen/_48sdp"
            android:layout_margin="@dimen/_12sdp"
            app:contentPadding="@dimen/_6sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/rounded50"
            app:strokeColor="@color/main_color"
            app:strokeWidth="1dp"
            tools:src="@drawable/app_logo" />

        <TextView
            android:id="@+id/notification_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_8sdp"
            android:maxLines="3"
            android:textColor="@color/main_color_2"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="@id/notification_client_image"
            app:layout_constraintEnd_toStartOf="@id/pin_icon"
            app:layout_constraintStart_toEndOf="@id/notification_client_image"
            app:layout_constraintTop_toTopOf="@id/notification_client_image"
            tools:text="Description Description lol Description Description lol Description Description lol Description Description Description Description Description Description Description Description Description Description Description " />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/pin_icon"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_32sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:src="@drawable/ic_pin_"
            android:tint="@color/green_9"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/notification_description"
            app:layout_constraintTop_toTopOf="@id/notification_client_image" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>