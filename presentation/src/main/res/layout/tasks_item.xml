<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_6sdp"
    android:background="@drawable/item_background">

    <TextView
        android:id="@+id/task_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_6sdp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        android:textColor="@color/main_color"
        android:textSize="@dimen/_12sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Freelance Android Application " />


    <LinearLayout
        android:id="@+id/linear_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_6sdp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/task_title"
        app:layout_constraintTop_toBottomOf="@id/task_title">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="State:"
            android:textColor="@color/main_color"
            android:textSize="@dimen/_10sdp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="Money:"
            android:textColor="@color/main_color"
            android:textSize="@dimen/_10sdp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="Type:"
            android:textColor="@color/main_color"
            android:textSize="@dimen/_10sdp" />


    </LinearLayout>

    <LinearLayout
        android:id="@+id/linear_values"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/linear_title"
        app:layout_constraintEnd_toStartOf="@id/task_client_image"
        app:layout_constraintStart_toEndOf="@id/linear_title"
        android:layout_marginStart="@dimen/_6sdp"
        app:layout_constraintTop_toTopOf="@id/linear_title">


        <TextView
            android:id="@+id/task_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="In Progress"
            android:textColor="@color/main_color_2"
            android:textSize="@dimen/_10sdp" />

        <TextView
            android:id="@+id/task_money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="300$"
            android:textColor="@color/main_color_2"
            android:textSize="@dimen/_10sdp" />

        <TextView
            android:id="@+id/task_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:maxLines="1"
            android:text="Android"
            android:textColor="@color/main_color_2"
            android:textSize="@dimen/_10sdp" />


    </LinearLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/task_client_image"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_6sdp"
        app:contentPadding="@dimen/_3sdp"
        app:layout_constraintBottom_toBottomOf="@id/linear_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:shapeAppearanceOverlay="@style/rounded50"
        app:strokeColor="@color/main_color"
        app:strokeWidth="1dp"
        tools:src="@drawable/app_logo" />

</androidx.constraintlayout.widget.ConstraintLayout>